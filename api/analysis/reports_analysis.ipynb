    "monthly = get_df(\"/reports/sales-by-month\")\n",
    "monthly[\"month\"] = pd.to_datetime(monthly[\"month\"])\n",
    "monthly[\"average_ticket\"] = (monthly[\"revenue\"] / monthly[\"sales_count\"]).round(2)\n",
    "\n",
    "# The last month is partial if the last sale is not near the end of the month\n",
    "last_sale = pd.to_datetime(summary[\"last_sale\"]).tz_localize(None)\n",
    "partial_month = last_sale.day < 28\n",
    "monthly.assign(month=monthly[\"month\"].dt.strftime(\"%Y-%m\"))"
   ]
